# HTTPS entry point. Caddy obtains and renews the Let's Encrypt certificate automatically.
# DOMAIN comes from /opt/ymejibu/.env (e.g. em.203-0-113-10.sslip.io or em.ymejibu.org).
{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	reverse_proxy web:80
}
